<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	Real parent of core/ and spring-boot-starter/ - both inherit their
	<version> from here rather than declaring their own, so a single
	release:prepare run at this root bumps both together and they can never
	drift out of sync. distributionManagement and the release-plugin config
	live here for the same reason: one release, one tag, one publish
	covering both artifacts.

	This POM itself also gets installed/published alongside them (a
	pom-packaging project's own "artifact" is just its POM) - anything that
	resolves core's or the starter's published POM externally (a fresh
	local install, CI, a real GitHub Packages consumer) needs to resolve
	this <parent> too, the same as any other real multi-module Maven
	project's parent POM.

	samples/* are deliberately NOT modules here - both are standalone Maven
	projects that depend on the published/installed artifacts as an
	ordinary external dependency, the same way a real downstream consumer
	would, rather than resolving them through this reactor. See
	docs/design/compile-time-proxy-generation.md for why that's intentional.
	-->
	<groupId>io.github.shrinivas93</groupId>
	<artifactId>rest-in-peace-parent</artifactId>
	<version>1.0.0.45-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>rest-in-peace-parent</name>
	<description>Shared parent POM for rest-in-peace and rest-in-peace-spring-boot-starter - a simple, declarative and peaceful REST client for Java.</description>
	<url>https://github.com/shrinivas93/REST-in-peace</url>

	<!-- Required by Maven Central for every published POM (a child module's
	     own effective POM inherits these, since <licenses>/<developers>,
	     unlike <name>/<description>, follow ordinary Maven inheritance) -
	     see the Maven Central publishing item in ROADMAP.md. -->
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://github.com/shrinivas93/REST-in-peace/blob/master/LICENSE</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>shrinivas93</id>
			<name>Shrinivas Shukla</name>
			<email>ssshukla1993@gmail.com</email>
			<url>https://github.com/shrinivas93</url>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/shrinivas93/REST-in-peace.git</connection>
		<developerConnection>scm:git:https://github.com/shrinivas93/REST-in-peace.git</developerConnection>
		<url>https://github.com/shrinivas93/REST-in-peace</url>
		<tag>HEAD</tag>
	</scm>

	<modules>
		<module>core</module>
		<module>spring-boot-starter</module>
	</modules>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>3.3.1</version>
				<configuration>
					<tagNameFormat>v@{project.version}</tagNameFormat>
					<!-- Both modules inherit this project's version rather than
					     declaring their own, so there's only ever one version to
					     bump - autoVersionSubmodules skips the per-module prompt
					     that assumes otherwise. -->
					<autoVersionSubmodules>true</autoVersionSubmodules>
				</configuration>
			</plugin>
			<!-- Declared here (not pluginManagement) so both core and
			     spring-boot-starter inherit it automatically - no per-module
			     repetition needed, same reasoning as maven-release-plugin above.
			     0.8.15 (bumped from 0.8.12 via #174) is confirmed running under
			     the real JDK 8 that ci.yml's `test` job builds core with - the
			     plugin and its org.jacoco.core/report/agent dependencies are all
			     still Java-8-targeted (class file major version 49-52) as of
			     this release, despite an earlier, now-outdated assumption here
			     that 0.8.13+ needed JDK 11. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<!-- Binds the coverage agent into surefire's argLine - no
					     explicit <phase>, so it uses prepare-agent's own default
					     (initialize, before any test runs). -->
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<!-- Generates target/site/jacoco/{index.html,jacoco.xml} right
					     after tests finish, as part of the ordinary `mvn test` - not
					     a separate goal a contributor has to remember to run. -->
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<distributionManagement>
		<repository>
			<id>github</id>
			<name>GitHub Packages</name>
			<url>https://maven.pkg.github.com/shrinivas93/REST-in-peace</url>
		</repository>
	</distributionManagement>

	<!-- Maven Central publishing, kept behind a profile rather than always-on:
	     central-publishing-maven-plugin's own <extensions>true</extensions>
	     takes over the deploy mechanism entirely once active, which would
	     hijack the plain `mvn deploy` the existing GitHub Packages step
	     (maven-publish.yml) already relies on. Activated explicitly
	     (`mvn -Pcentral deploy`) as a separate step/job instead, so the two
	     publish targets never fight over the same `deploy` invocation. GPG
	     signing lives in this same profile for the same reason - only
	     needed, and only required to be configured (a GPG key on the
	     runner), when actually publishing to Central, not for every
	     ordinary `mvn test`/`mvn package`/GitHub Packages deploy. -->
	<profiles>
		<profile>
			<id>central</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.7</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<!-- extensions=true is what lets this plugin intercept `deploy`
					     for the whole reactor and upload a signed bundle to the
					     Central Portal's Publisher API, instead of a plain PUT to
					     distributionManagement/repository the way GitHub Packages
					     works - publishingServerId names the <server> entry (id
					     "central") CI's settings.xml supplies the Central user
					     token's username/password under, matching maven-publish.yml.
					     autoPublish is deliberately false: a bundle lands in Central
					     Portal's "validated, awaiting manual publish" state instead of
					     going live immediately, so a bad release can be caught (and
					     dropped) before it's irreversible - Central has no unpublish
					     once a bundle is actually released. -->
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.11.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>false</autoPublish>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
