<project xmlns="http://maven.apache.org/POM/4.0.0">
	<modelVersion>4.0.0</modelVersion>

	<!--
	A standalone Maven project - deliberately NOT a module of the parent
	rest-in-peace build (core and spring-boot-starter are sibling reactor
	modules of it, but this sample isn't) - showing how a real downstream
	consumer sees compile-time proxy generation
	(../../docs/design/compile-time-proxy-generation.md): add the library as
	an ordinary dependency, write a plain @RestClient interface, and get a
	real generated implementation with zero extra configuration. See this
	directory's README.md to build and run it.
	-->
	<groupId>com.example</groupId>
	<artifactId>compile-time-proxy-consumer</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>

	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Must match core's own pom.xml <version> - see README.md. -->
		<rest-in-peace.version>1.0.0.36-SNAPSHOT</rest-in-peace.version>
	</properties>

	<dependencies>
		<!-- An ordinary dependency - nothing else added, no
		     annotationProcessorPaths configured - to prove the processor
		     auto-activates via its bundled SPI file with zero extra
		     consumer-side configuration. -->
		<dependency>
			<groupId>com.shri</groupId>
			<artifactId>rest-in-peace</artifactId>
			<version>${rest-in-peace.version}</version>
		</dependency>
	</dependencies>

	<profiles>
		<!--
		Builds this same consumer as a GraalVM native executable - the
		native-image smoke test for compile-time proxy generation (step 3 of
		../../docs/design/compile-time-proxy-generation.md's rollout plan):
		the concrete, checkable proof that RIP.getClient(ItemApi.class)'s
		generated _RipImpl path is genuinely reflection-free, not just an
		assumption resting on "we removed the Proxy/getAnnotation calls".
		Kept behind a profile (mvn -Pnative package) so the plain `mvn
		compile` flow the existing Sample Consumer Test CI job uses stays
		exactly as fast and JDK-8-only as before - only a job that actually
		wants a native executable needs a GraalVM JDK on its PATH.
		-->
		<profile>
			<id>native</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<version>1.1.12</version>
						<extensions>true</extensions>
						<executions>
							<execution>
								<id>build-native</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<imageName>compile-time-proxy-consumer</imageName>
							<mainClass>com.example.consumer.NativeMain</mainClass>
							<buildArgs>
								<!-- Fail the build instead of silently falling back to a
								     JVM-based executable on unsupported reflection/JNI usage -
								     a fallback would hide exactly the failure this smoke test
								     exists to catch. -->
								<buildArg>--no-fallback</buildArg>
							</buildArgs>
							<!-- The compatible window for this repository's own
							     version history turned out to be narrower and less
							     monotonic than expected - three prior attempts, in
							     order, each hit a different failure:
							       - 1.0.12 / 1.0.13 (native-maven-plugin 1.1.12's own
							         default): GraalVM 21.0.2 (CI-pinned) rejects their
							         schema content as too new ("your GraalVM
							         installation ... does not [support this schema]").
							       - 0.3.9 (what this project's previous plugin version,
							         0.10.3, itself bundled): older than the plugin will
							         even accept the packaging of ("does not contain a
							         'schemas' directory. Requires ... 0.3.33 or newer").
							       - 0.3.33 (the plugin's own stated minimum): the
							         plugin itself then rejects it from the OTHER
							         direction - "contains more schema files than
							         supported ... Found 3 files ... but exactly 2 are
							         supported" - so the repository's own schema-file
							         count isn't monotonic with version number between
							         0.3.33 and 1.0.12.
							     1.0.0 - the first stable release past the 0.3.x line -
							     is the next candidate: past whichever release trimmed
							     the schema-file count back to 2 (satisfying the
							     plugin's own count check the way 1.0.12 already does),
							     while still far enough before 1.0.12/1.0.13 to plausibly
							     predate whatever content change those need a newer
							     GraalVM for. Bumping the pinned GraalVM major instead
							     of narrowing this window was tried first but broke
							     annotation processing for this project's own
							     compile-time codegen (see ci.yml's own comment on that).
							     Keeps the exact per-library configs (Apache
							     HttpClient/HttpCore/HttpMime, commons-logging,
							     commons-codec, Gson) this smoke test's real HTTP call
							     needs at runtime under native-image's closed-world
							     analysis, unchanged from what was already working. -->
							<metadataRepository>
								<version>1.0.0</version>
							</metadataRepository>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
