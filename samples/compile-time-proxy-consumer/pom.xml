<project xmlns="http://maven.apache.org/POM/4.0.0">
	<modelVersion>4.0.0</modelVersion>

	<!--
	A standalone Maven project - deliberately NOT a module of the parent
	rest-in-peace build (core and spring-boot-starter are sibling reactor
	modules of it, but this sample isn't) - showing how a real downstream
	consumer sees compile-time proxy generation
	(../../docs/design/compile-time-proxy-generation.md): add the library as
	an ordinary dependency, write a plain @RestClient interface, and get a
	real generated implementation with zero extra configuration. See this
	directory's README.md to build and run it.
	-->
	<groupId>com.example</groupId>
	<artifactId>compile-time-proxy-consumer</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>

	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Must match core's own pom.xml <version> - see README.md. -->
		<rest-in-peace.version>1.0.0.36-SNAPSHOT</rest-in-peace.version>
	</properties>

	<dependencies>
		<!-- An ordinary dependency - nothing else added, no
		     annotationProcessorPaths configured - to prove the processor
		     auto-activates via its bundled SPI file with zero extra
		     consumer-side configuration. -->
		<dependency>
			<groupId>io.github.shrinivas93</groupId>
			<artifactId>rest-in-peace</artifactId>
			<version>${rest-in-peace.version}</version>
		</dependency>
	</dependencies>

	<profiles>
		<!--
		Builds this same consumer as a GraalVM native executable - the
		native-image smoke test for compile-time proxy generation (step 3 of
		../../docs/design/compile-time-proxy-generation.md's rollout plan):
		the concrete, checkable proof that RIP.getClient(ItemApi.class)'s
		generated _RipImpl path is genuinely reflection-free, not just an
		assumption resting on "we removed the Proxy/getAnnotation calls".
		Kept behind a profile (mvn -Pnative package) so the plain `mvn
		compile` flow the existing Sample Consumer Test CI job uses stays
		exactly as fast and JDK-8-only as before - only a job that actually
		wants a native executable needs a GraalVM JDK on its PATH.
		-->
		<profile>
			<id>native</id>
			<build>
				<plugins>
					<!-- Scoped to this profile only, not the plain build above: GraalVM
					     25's javac (see ci.yml's own comment on the version bump this
					     went with) tightened implicit, classpath-only annotation
					     processor discovery enough that it stopped auto-activating
					     RestClientProcessor here, so ItemApi_RipImpl was never
					     generated. Naming the processor explicitly - just for this
					     native-image build - restores that without touching the
					     plain `mvn compile` path the sample-consumer CI job still uses
					     to demonstrate genuine zero-config auto-activation via the
					     bundled SPI file (this dependency block's own comment, and
					     docs/design/compile-time-proxy-generation.md's own
					     documented invariant that this smoke test actually protects -
					     zero *hand-written* native-image reflect/proxy config - is
					     unaffected either way: RestClientProcessor still emits its
					     own reflect-config.json with no manual edits anywhere in this
					     project's own resources. -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<annotationProcessors>
								<annotationProcessor>com.shri.restinpeace.processor.RestClientProcessor</annotationProcessor>
							</annotationProcessors>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<version>1.1.12</version>
						<extensions>true</extensions>
						<executions>
							<execution>
								<id>build-native</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<imageName>compile-time-proxy-consumer</imageName>
							<mainClass>com.example.consumer.NativeMain</mainClass>
							<buildArgs>
								<!-- Fail the build instead of silently falling back to a
								     JVM-based executable on unsupported reflection/JNI usage -
								     a fallback would hide exactly the failure this smoke test
								     exists to catch. -->
								<buildArg>--no-fallback</buildArg>
							</buildArgs>
							<!-- No explicit version pin: GraalVM 21.0.2 (this job's old
							     pin) rejected the plugin's own default reachability-metadata
							     schema as too new, which drove a whole version-hunt across
							     older releases (see this file's git history) that never
							     found one compatible with both the plugin's own packaging
							     checks and GraalVM 21. Bumping the job to GraalVM 25
							     (ci.yml) targets the schema the plugin's default already
							     expects, so no override should be needed here any more -
							     first thing to check if this job's schema error returns. -->
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
