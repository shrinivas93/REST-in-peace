<project xmlns="http://maven.apache.org/POM/4.0.0">
	<modelVersion>4.0.0</modelVersion>

	<!--
	A standalone Maven project - deliberately NOT a module of the parent
	rest-in-peace build (this repo is single-module by design) - showing
	what a real downstream consumer sees from the Spring Boot starter
	(../../docs/design/spring-boot-starter.md): add both the core library
	and rest-in-peace-spring-boot-starter as ordinary dependencies,
	annotate a single @RestClient interface, and get a working Spring bean
	with zero hand-written @Bean method. See this directory's README.md to
	build and run it.
	-->
	<groupId>com.example</groupId>
	<artifactId>spring-boot-consumer</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>

	<properties>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Must match rest-in-peace's own pom.xml <version> - see README.md. -->
		<rest-in-peace.version>1.0.0.1-SNAPSHOT</rest-in-peace.version>
		<!-- Must match spring-boot-starter/pom.xml's own <version> - see README.md. -->
		<rest-in-peace-spring-boot-starter.version>0.1.0-SNAPSHOT</rest-in-peace-spring-boot-starter.version>
		<spring-boot.version>4.1.1</spring-boot.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Ordinary dependencies - nothing else added beyond the starter
		     itself, to prove @EnableRestInPeaceClients auto-registers
		     UserApi below with zero extra consumer-side configuration. -->
		<dependency>
			<groupId>com.shri</groupId>
			<artifactId>rest-in-peace</artifactId>
			<version>${rest-in-peace.version}</version>
		</dependency>
		<dependency>
			<groupId>com.shri</groupId>
			<artifactId>rest-in-peace-spring-boot-starter</artifactId>
			<version>${rest-in-peace-spring-boot-starter.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
			</plugin>
		</plugins>
	</build>

</project>
