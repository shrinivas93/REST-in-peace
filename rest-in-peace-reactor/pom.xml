<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.shrinivas93</groupId>
		<artifactId>rest-in-peace-parent</artifactId>
		<version>1.0.0.54-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>rest-in-peace-reactor</artifactId>
	<packaging>jar</packaging>

	<name>rest-in-peace-reactor</name>
	<url>https://github.com/shrinivas93/REST-in-peace</url>
	<description>
		Project Reactor CallAdapterFactory implementations for REST-in-peace -
		Mono&lt;T&gt; and Flux&lt;T&gt; return-type support, including a
		backpressure-aware Flux&lt;T&gt; over @Paginated methods.
		See docs/design/reactor-call-adapter.md in the parent repository for
		the full design and rollout plan. A sibling reactor module of core/
		(not a dependent of it in the reactor sense - it resolves core the
		same way a real downstream consumer would, as an ordinary Maven
		dependency), sharing core's version and release cadence via their
		common parent. Targets Java 8, matching core, since this module adds
		no framework requirement of its own beyond reactor-core itself
		(unlike rest-in-peace-spring-boot-starter, which needs Java 17+ for
		Spring Boot 4.x).
	</description>

	<!-- Version, scm, distributionManagement, and release-plugin config are
	     all inherited from the parent - see pom.xml's own comment for why. -->

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
		<reactor.version>2023.0.19</reactor.version>
		<!-- Held back to the same 5.x line core itself uses, for the same reason
		     core/pom.xml's own comment gives: JUnit 6.x requires Java 17 minimum,
		     which breaks compiling this module's tests outright under the real
		     JDK 8 ci.yml's `test` job builds it with. -->
		<junit.version>5.14.4</junit.version>
		<!-- This module is local-only for now (docs/design/reactor-call-adapter.md
		     §"isn't published yet"): it shares this reactor's root pom.xml purely
		     for the version/release-cadence sync ci.yml and release.yml rely on,
		     not because it's meant to ship. Without this, `mvn deploy` run from
		     the root reactor (maven-publish.yml's GitHub Packages step) would
		     publish this jar right alongside core/spring-boot-starter, silently
		     changing what's public before anyone decided it should be.
		     maven.deploy.skip is honored by the ordinary maven-deploy-plugin, so
		     it keeps this module out of GitHub Packages without touching that
		     workflow. It is NOT honored by central-publishing-maven-plugin
		     though (still an open feature request upstream, as of this writing -
		     see mavenplugins/central-publishing-maven-plugin#22) - the `central`
		     profile below carries this module's own opt-out for that separate
		     publish path. `mvn install` (ci.yml's consumer-test job) is
		     unaffected either way - only `deploy` is skipped. -->
		<maven.deploy.skip>true</maven.deploy.skip>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- reactor-bom pins reactor-core/reactor-test to one mutually
			     compatible pair, the same "import one BOM instead of pinning each
			     artifact's version by hand" shape spring-boot-starter's own
			     spring-boot-dependencies import already uses. -->
			<dependency>
				<groupId>io.projectreactor</groupId>
				<artifactId>reactor-bom</artifactId>
				<version>${reactor.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<!-- Same version as this module by construction - both inherit it
			     from the shared parent, so ${project.version} always names
			     whatever core version this build is paired with. -->
			<groupId>io.github.shrinivas93</groupId>
			<artifactId>rest-in-peace</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<!-- The only new runtime dependency this module adds - never present
			     in core's own pom.xml. -->
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- StepVerifier - Reactor's own standard test utility for asserting on
			     a Mono/Flux's emitted signals. -->
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.6.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.12.0</version>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- See core/pom.xml's own comment - required by Maven Central, and a
			     normal convenience for GitHub Packages consumers too. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.4.0</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!-- Mirrors the root pom.xml's own `central` profile (same id, so Maven
	     merges this into it for this module only): central-publishing-maven-plugin
	     takes over the `deploy` phase reactor-wide once that profile activates,
	     the same as maven-deploy-plugin does for the plain GitHub Packages
	     deploy above - but unlike maven-deploy-plugin, it doesn't honor
	     maven.deploy.skip (see that property's own comment), so this module
	     needs its own explicit skipPublishing override to stay out of the
	     published bundle a tagged release's `mvn -Pcentral deploy` step
	     otherwise uploads to Maven Central. groupId/artifactId/extensions/
	     version all come from the root profile's own plugin declaration -
	     only the per-module skip needs restating here. -->
	<profiles>
		<profile>
			<id>central</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<configuration>
							<skipPublishing>true</skipPublishing>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
